{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Plinth Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "public",
    "registration",
    "database",
    "persistence",
    "resources",
    "traefik",
    "networkPolicy",
    "rolloutNonce"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]{1,5})?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              }
            }
          }
        }
      }
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "anyOf": [
            {"maxLength": 0},
            {
              "maxLength": 253,
              "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"
            }
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "keys", "poolSize"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "user", "password", "database"],
          "properties": {
            "host": {"$ref": "#/definitions/secretKey"},
            "port": {"$ref": "#/definitions/secretKey"},
            "user": {"$ref": "#/definitions/secretKey"},
            "password": {"$ref": "#/definitions/secretKey"},
            "database": {"$ref": "#/definitions/secretKey"}
          }
        },
        "poolSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "logs"],
      "properties": {
        "data": {"$ref": "#/definitions/persistence"},
        "logs": {"$ref": "#/definitions/persistence"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resources"},
        "limits": {"$ref": "#/definitions/resources"}
      }
    },
    "traefik": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingressClassName",
        "entryPoints",
        "tls",
        "limits",
        "forwardingTimeouts"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressClassName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName"],
          "properties": {
            "secretName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "defaultRequestBodyBytes",
            "maxRequestBodyBytes",
            "memoryRequestBodyBytes",
            "maxInFlightRequests",
            "maxPackageInFlightRequests"
          ],
          "properties": {
            "defaultRequestBodyBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "maxRequestBodyBytes": {
              "type": "integer",
              "minimum": 67108864,
              "maximum": 67108864
            },
            "memoryRequestBodyBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "maxInFlightRequests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "maxPackageInFlightRequests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            }
          }
        },
        "forwardingTimeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dialTimeout",
            "responseHeaderTimeout",
            "packageResponseHeaderTimeout",
            "idleConnTimeout"
          ],
          "properties": {
            "dialTimeout": {"$ref": "#/definitions/duration"},
            "responseHeaderTimeout": {"$ref": "#/definitions/duration"},
            "packageResponseHeaderTimeout": {"$ref": "#/definitions/duration"},
            "idleConnTimeout": {"$ref": "#/definitions/duration"}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "traefik", "dns", "database"],
      "properties": {
        "enabled": {"type": "boolean"},
        "traefik": {"$ref": "#/definitions/networkPeers"},
        "dns": {"$ref": "#/definitions/networkPeers"},
        "database": {"$ref": "#/definitions/databasePeer"}
      }
    },
    "rolloutNonce": {
      "type": "string",
      "maxLength": 128
    }
  },
  "definitions": {
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "size",
        "accessModes",
        "storageClassName",
        "retain"
      ],
      "properties": {
        "existingClaim": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "size": {"$ref": "#/definitions/quantity"},
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"]
          }
        },
        "storageClassName": {"type": "string"},
        "retain": {"type": "boolean"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory", "ephemeral-storage"],
      "properties": {
        "cpu": {"$ref": "#/definitions/quantity"},
        "memory": {"$ref": "#/definitions/quantity"},
        "ephemeral-storage": {"$ref": "#/definitions/quantity"}
      }
    },
    "quantity": {
      "type": "string",
      "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[EPTGMK]i?|[EPTGMkKmun])?$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:ms|s|m|h)$"
    },
    "cidr": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])$"
        },
        {
          "pattern": "^(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:))/(?:[0-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"
        }
      ]
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "networkPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaceSelector", "podSelector"],
      "properties": {
        "namespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "podSelector": {"$ref": "#/definitions/labelSelector"}
      }
    },
    "databasePodPeer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "podSelector": {"$ref": "#/definitions/labelSelector"}
      },
      "anyOf": [
        {"required": ["namespaceSelector"]},
        {"required": ["podSelector"]}
      ]
    },
    "networkPeers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peers"],
      "properties": {
        "peers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/networkPeer"}
        }
      }
    },
    "databasePeer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "peers", "ipBlocks"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "peers": {
          "type": "array",
          "items": {"$ref": "#/definitions/databasePodPeer"}
        },
        "ipBlocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cidr"],
            "properties": {
              "cidr": {"$ref": "#/definitions/cidr"},
              "except": {
                "type": "array",
                "items": {"$ref": "#/definitions/cidr"}
              }
            }
          }
        }
      },
      "anyOf": [
        {"properties": {"peers": {"minItems": 1}}},
        {"properties": {"ipBlocks": {"minItems": 1}}}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "traefik": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "public": {
            "properties": {"host": {"minLength": 1}}
          },
          "traefik": {
            "properties": {
              "tls": {
                "properties": {"secretName": {"minLength": 1}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registration": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "traefik": {
            "properties": {"enabled": {"const": false}}
          }
        }
      }
    }
  ]
}
