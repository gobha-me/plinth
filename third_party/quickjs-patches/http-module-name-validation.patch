Add an opt-in per-runtime decoded module-name validation hook before
C-string normalization and loaded-module lookup. Static and dynamic imports
preserve actual base/specifier lengths. Existing runtimes without the hook
retain existing loader behavior. The C-string JS_LoadModule ABI is unchanged.

Against quickjs-ng 3c051980ab7e783dfbfb1c70c014ce5e05ecf24c, after the
existing Plinth cstring-conversion-failure-leak.patch.

diff --git a/quickjs.h b/quickjs.h
--- a/quickjs.h
+++ b/quickjs.h
@@ -1193,6 +1193,22 @@
 JS_EXTERN void JS_SetModuleNormalizeFunc2(JSRuntime *rt,
                                           JSModuleNormalizeFunc2 *module_normalize);
 
+/* Optional per-runtime validation before normalization and loaded-module lookup.
+   base/specifier contain decoded UTF-8 bytes and may include embedded NUL or
+   non-scalar sequences. The lengths are authoritative; bytes are borrowed only
+   during the callback. Return 0 to continue or -1 with a pending exception.
+   Any pending exception rejects, even if the callback returns 0. Never unwind
+   a foreign-language exception through this C API. The runtime borrows opaque;
+   its owner must outlive all contexts/jobs and runtime destruction. NULL turns
+   validation off without changing existing loader/normalizer callbacks. */
+typedef int JSModuleNameValidationFunc(JSContext *ctx,
+                                      const char *base, size_t base_len,
+                                      const char *specifier, size_t specifier_len,
+                                      void *opaque);
+JS_EXTERN void JS_SetModuleNameValidationFunc(JSRuntime *rt,
+                                              JSModuleNameValidationFunc *validate,
+                                              void *opaque);
+
 /* return the import.meta object of a module */
 JS_EXTERN JSValue JS_GetImportMeta(JSContext *ctx, JSModuleDef *m);
 JS_EXTERN JSAtom JS_GetModuleName(JSContext *ctx, JSModuleDef *m);
diff --git a/quickjs.c b/quickjs.c
--- a/quickjs.c
+++ b/quickjs.c
@@ -334,6 +334,8 @@
     } u;
     JSModuleCheckSupportedImportAttributes *module_check_attrs;
     void *module_loader_opaque;
+    JSModuleNameValidationFunc *module_name_validation_func;
+    void *module_name_validation_opaque;
     /* timestamp for internal use in module evaluation */
     int64_t module_async_evaluation_next_timestamp;
 
@@ -29225,6 +29227,14 @@
     rt->normalize_u.module_normalize_func2 = module_normalize;
 }
 
+void JS_SetModuleNameValidationFunc(JSRuntime *rt,
+                                    JSModuleNameValidationFunc *validate,
+                                    void *opaque)
+{
+    rt->module_name_validation_func = validate;
+    rt->module_name_validation_opaque = opaque;
+}
+
 int JS_SetModulePrivateValue(JSContext *ctx, JSModuleDef *m, JSValue val)
 {
     set_value(ctx, &m->private_value, val);
@@ -29314,13 +29324,28 @@
 /* `base_cname` and `cname1` may be pure ASCII or UTF-8 encoded */
 static JSModuleDef *js_host_resolve_imported_module(JSContext *ctx,
                                                     const char *base_cname,
+                                                    size_t base_len,
                                                     const char *cname1,
+                                                    size_t cname1_len,
                                                     JSValueConst attributes)
 {
     JSRuntime *rt = ctx->rt;
     JSModuleDef *m;
     char *cname;
     JSAtom module_name;
+
+    /* Length-complete validation must precede BOTH C-string normalization and
+       the loaded-module cache, including when the target is already loaded. */
+    if (rt->module_name_validation_func) {
+        int result = rt->module_name_validation_func(ctx, base_cname, base_len,
+                                                      cname1, cname1_len,
+                                                      rt->module_name_validation_opaque);
+        if (result != 0 || JS_HasException(ctx)) {
+            if (!JS_HasException(ctx))
+                JS_ThrowTypeError(ctx, "module name validation rejected import");
+            return NULL;
+        }
+    }
 
     if (!rt->normalize_u.module_normalize_func && !rt->normalize_u.module_normalize_func2) {
         cname = js_default_module_normalize_name(ctx, base_cname, cname1);
@@ -29376,17 +29401,18 @@
                                                          JSValueConst attributes)
 {
     const char *base_cname, *cname;
+    size_t base_len, cname_len;
     JSModuleDef *m;
 
-    base_cname = JS_AtomToCString(ctx, base_module_name);
+    base_cname = JS_AtomToCStringLen(ctx, &base_len, base_module_name);
     if (!base_cname)
         return NULL;
-    cname = JS_AtomToCString(ctx, module_name1);
+    cname = JS_AtomToCStringLen(ctx, &cname_len, module_name1);
     if (!cname) {
