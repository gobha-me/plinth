+bool EventLoopThreadPool::stopFor(std::chrono::milliseconds timeout)
+{
+    const bool unbounded = timeout == std::chrono::milliseconds::max();
+    const auto deadline = unbounded
+                              ? std::chrono::steady_clock::time_point::max()
+                              : std::chrono::steady_clock::now() + timeout;
+    for (const auto &loopThread : loopThreadVector_)
+        loopThread->requestStop();
+    for (const auto &loopThread : loopThreadVector_)
+    {
+        const auto now = std::chrono::steady_clock::now();
+        if (!unbounded && now >= deadline)
+            return false;
+        const auto remaining =
+            unbounded ? std::chrono::milliseconds::max()
+                      : std::chrono::duration_cast<std::chrono::milliseconds>(
+                            deadline - now);
+        if (!loopThread->waitFor(remaining))
+            return false;
+    }
+    return true;
+}
