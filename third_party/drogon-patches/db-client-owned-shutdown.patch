+bool DbClientImpl::closeAllFor(std::chrono::milliseconds timeout)
+{
+    const bool unbounded = timeout == std::chrono::milliseconds::max();
+    const auto deadline = unbounded
+                              ? std::chrono::steady_clock::time_point::max()
+                              : std::chrono::steady_clock::now() + timeout;
+    if (type_ == ClientType::PostgreSQL)
+    {
+        stopping_->store(true, std::memory_order_release);
+        if (loops_.isCurrentThread())
+        {
+            LOG_ERROR << "Refusing to initiate database client shutdown from "
+                         "its own event loop";
+            return false;
+        }
+    }
+    std::unique_lock<std::timed_mutex> shutdownLock(shutdownMutex_,
+                                                    std::defer_lock);
+    if (unbounded)
+        shutdownLock.lock();
+    else if (!shutdownLock.try_lock_until(deadline))
+        return false;
+    if (shutdownComplete_)
+        return true;
+
+    // This owned-loop drain addresses PostgreSQL clients. SQLite connections
+    // own a different per-connection loop, and MySQL keeps its established
+    // lifecycle contract; preserve their pre-existing synchronous close path.
+    if (type_ != ClientType::PostgreSQL)
+    {
+        if (!unbounded)
+            return false;
+        stopping_->store(true, std::memory_order_release);
+        decltype(connections_) connections;
+        {
+            std::lock_guard<std::mutex> lock(connectionsMutex_);
+            connections.swap(connections_);
+            readyConnections_.clear();
+            busyConnections_.clear();
+        }
+        for (auto const &conn : connections)
+            conn->disconnect();
+        shutdownComplete_ = true;
+        return true;
+    }
+
+    stopping_->store(true, std::memory_order_release);
+    std::unique_lock<std::shared_timed_mutex> admissionLock(*admissionMutex_,
+                                                            std::defer_lock);
+    if (unbounded)
+        admissionLock.lock();
+    else if (!admissionLock.try_lock_until(deadline))
+        return false;
+
+    auto remaining = [deadline, unbounded]() {
+        if (unbounded)
+            return std::chrono::milliseconds::max();
+        const auto now = std::chrono::steady_clock::now();
+        if (now >= deadline)
+            return std::chrono::milliseconds::zero();
+        return std::chrono::duration_cast<std::chrono::milliseconds>(deadline -
+                                                                     now);
+    };
+    if (loopsStopRequested_)
+    {
+        admissionLock.unlock();
+        if (!loops_.stopFor(remaining()))
+            return false;
+        shutdownComplete_ = true;
+        return true;
+    }
+
+    auto drainLoops = [this, deadline, unbounded]() {
+        std::vector<std::future<void>> barriers;
+        for (auto *loop : loops_.getLoops())
+        {
+            if (loop->isInLoopThread())
+            {
+                LOG_ERROR << "Refusing to drain a database client from its "
+                             "own event loop";
+                return false;
+            }
+            auto barrier = std::make_shared<std::promise<void>>();
+            barriers.push_back(barrier->get_future());
+            loop->queueInLoop([barrier]() { barrier->set_value(); });
+        }
+        for (auto &barrier : barriers)
+        {
+            if (!unbounded &&
+                barrier.wait_until(deadline) != std::future_status::ready)
+                return false;
+            barrier.get();
+        }
+        return true;
+    };
+
+    // Callbacks which observed stopping_ == false before the transition are
+    // ahead of these barriers. Later callbacks reject before locking weakThis,
+    // so none can become the last DbClientImpl owner on a private DB loop.
+    admissionLock.unlock();
+    if (!drainLoops())
+        return false;
+
+    decltype(transCallbacks_) transCallbacks;
+    decltype(sqlCmdBuffer_) sqlCommands;
+    if (!connectionsClosed_)
     {
         std::lock_guard<std::mutex> lock(connectionsMutex_);
-        connections.swap(connections_);
+        closingConnections_.swap(connections_);
         readyConnections_.clear();
         busyConnections_.clear();
+        transCallbacks.swap(transCallbacks_);
+        sqlCommands.swap(sqlCmdBuffer_);
+        connectionsClosed_ = true;
+    }
+    auto stopped =
+        std::make_exception_ptr(Failure("Database client is shutting down"));
+    auto callbackLoop = loops_.getNextLoop();
+    for (const auto &callback : transCallbacks)
+    {
+        callbackLoop->queueInLoop([callback]() {
+            try
+            {
+                (*callback)(nullptr);
+            }
+            catch (...)
+            {
+                LOG_ERROR << "Transaction shutdown callback threw";
+            }
+        });
+        callbackLoop = loops_.getNextLoop();
     }
-    for (auto const &conn : connections)
+    for (const auto &command : sqlCommands)
     {
-        conn->disconnect();
+        callbackLoop->queueInLoop([command, stopped]() {
+            try
+            {
+                command->exceptionCallback_(stopped);
+            }
+            catch (...)
+            {
+                LOG_ERROR << "SQL shutdown callback threw";
+            }
+        });
+        callbackLoop = loops_.getNextLoop();
     }
+    if (!drainLoops())
+        return false;
+    if (!disconnectQueued_)
+    {
+        for (auto const &conn : closingConnections_)
+        {
+            auto *loop = conn->loop();
+            if (loop)
+                loop->queueInLoop([conn]() { conn->disconnect(); });
+            else
+                conn->disconnect();
+        }
+        disconnectQueued_ = true;
+    }
+    // disconnect() may enqueue close callbacks. Drain them while the caller
+    // still owns the client, then return ownership to the lifecycle thread.
+    if (!drainLoops())
+        return false;
+    closingConnections_.clear();
+    if (!drainLoops())
+        return false;
+    loopsStopRequested_ = true;
+    if (!loops_.stopFor(remaining()))
+        return false;
+    shutdownComplete_ = true;
+    return true;
 }

