        "assert_deny":  {"call": "brokenallow:1:edit", "expect": "permission_denied"},
        "assert_allow": {"call": "brokenallow:1:edit", "expect": "success"}
      }
    },
    {
      "rule": "brokenallow.other_rule",
      "namespace": "brokenallow",
      "description": "The rule the capability actually requires"
    }
  ]
