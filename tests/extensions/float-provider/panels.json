{
  "format_version": 2,
  "panels": [
    {
      "id": "preview",
      "type": "float",
      "title": "Fixture Preview",
      "icon": "edit-3",
      "rbac_rule": "floatprovider.panel",
      "client_path": "preview.js",
      "capability": "floatprovider:1:preview",
      "content_types": ["application/x-plinth-float-fixture"],
      "context_schema": {
        "version": 1,
        "fields": {
          "record_id": {"required": true, "max_bytes": 64, "meaning": "Stable fake fixture record identifier"}
        },
        "persist_keys": ["record_id"]
      }
    },
    {
      "id": "live",
      "type": "float",
      "title": "Live-only Fixture",
      "icon": "edit-3",
      "rbac_rule": "floatprovider.panel",
      "client_path": "preview.js",
      "capability": "floatprovider:1:preview",
      "content_types": ["application/x-plinth-float-live"],
      "context_schema": {
        "version": 1,
        "fields": {
          "record_id": {"required": true, "max_bytes": 64, "meaning": "Stable fake fixture record identifier"},
          "live_nonce": {"required": true, "max_bytes": 64, "meaning": "Required transient fake fixture nonce, deliberately not approved for persistence"}
        },
        "persist_keys": ["record_id"]
      }
    },
    {
      "id": "nav-a",
      "type": "primary",
      "title": "Typed receiver A",
      "rbac_rule": "floatprovider.panel",
      "client_path": "typed.js",
      "accepts_navigation_intent": true,
      "context_schema": {
        "version": 1,
        "fields": {"record_id": {"required": false, "max_bytes": 64, "meaning": "Stable fake navigation record identifier"}},
        "persist_keys": []
      }
    },
    {
      "id": "nav-b",
      "type": "primary",
      "title": "Typed receiver B",
      "rbac_rule": "floatprovider.panel",
      "client_path": "typed.js",
      "accepts_navigation_intent": true,
      "context_schema": {"version": 1, "fields": {}, "persist_keys": []}
    },
    {
      "id": "legacy-primary",
      "type": "primary",
      "title": "Not opted into typed navigation",
      "rbac_rule": "floatprovider.panel",
      "client_path": "typed.js"
    },
    {
      "id": "status-a",
      "type": "tray",
      "title": "Typed status A",
      "rbac_rule": "floatprovider.panel",
      "client_path": "typed.js",
      "tray_states": {"idle": "circle", "busy": "loader"},
      "tray_initial_state": "idle",
      "preferred_width": 320,
      "chrome_essential": true
    },
    {
      "id": "status-b",
      "type": "tray",
      "title": "Typed status B",
      "rbac_rule": "floatprovider.panel",
      "client_path": "typed.js",
      "tray_states": {"idle": "circle"},
      "tray_initial_state": "idle",
      "preferred_width": 320
    }
  ]
}
